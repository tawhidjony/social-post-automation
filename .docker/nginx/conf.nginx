map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

upstream laravel {
    server tawhidjony-php:8080;
}

upstream vite {
    server tawhidjony-php:5173;
}

server {
    listen 80;
    listen [::]:80;
    server_name social-post-automation.test;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name social-post-automation.test;

    ssl_certificate /etc/nginx/certs/social-post-automation.test.crt;
    ssl_certificate_key /etc/nginx/certs/social-post-automation.test.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 100M;

    location /vite-hmr {
        proxy_pass http://vite;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
    }

    location ~ ^/(__laravel_vite_plugin__|__inertia_ssr|@vite|@id|@fs|@react-refresh|node_modules|resources)(/|$) {
        proxy_pass http://vite;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300;
    }

    location / {
        proxy_pass http://laravel;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300;
    }
}
